;; Plan metadata
(meta plan
  (id "SPEC-032")
  (title "did-crdt — Coordination-Free Decentralised Identifiers via Signed CRDTs")
  (version "0.1.0")
  (status "draft")
  (created "2026-03-10")
  (author "agent:architect")
  (spec "SPEC-031")
  (description "Implement did:crdt — a W3C-compliant DID method using signed CRDTs for coordination-free convergence across replicas"))

;; Agents
(given agent-engineer-available)
(given agent-security-available)
(given agent-devops-available)

;; ─── PHASE 1: PURE CORE ───────────────────────────────────────────────────

;; Tasks
(given task-scaffold-crate)
(given task-crdt-field-wrappers)
(given task-document-struct)
(given task-signed-delta)
(given task-hlc)
(given task-validate)
(given task-resolve)
(given task-did-type)
(given task-proptest-merge)
(given task-proptest-rotation)
(given task-proptest-deactivation)
(given task-benchmark-core)
(given task-forbid-unsafe-core)

;; No-dependency seeds
(given no-deps-scaffold-crate)

;; Task metadata
(meta task-scaffold-crate
  (description "Scaffold the Rust crate with the module structure defined in the spec: core/, sync/, service/, anchor/, tests/, benches/, fuzz/, examples/")
  (acceptance "cargo build --no-default-features succeeds; module tree matches spec section 17; CI runs"))

(meta task-crdt-field-wrappers
  (description "Implement typed CRDT field wrappers over the crdts crate: G-Set for verificationMethods and revocations, ORSWOT for serviceEndpoints, LWW-Map for documentData, Max-Register for activeKey and deactivated")
  (acceptance "All six field types compile; deactivation latch and rotation seq-check invariants enforced; no unsafe in core module"))

(meta task-document-struct
  (description "Implement Document struct with new(), merge(), merge_state(), resolve(), content_hash(), to_bytes(), from_bytes() as specified in CON-001")
  (acceptance "Document::new() returns deterministic content_hash(); merge() returns correct MergeOutcome; to_bytes/from_bytes round-trip is lossless"))

(meta task-signed-delta
  (description "Implement SignedDelta construction and deterministic canonical JSON serialisation as specified in CON-002; integrate ssi crate for EcdsaSecp256k1Signature2019 and Ed25519Signature2020")
  (acceptance "SignedDelta round-trips through serde; canonical JSON has sorted keys; signature computation matches ssi suite"))

(meta task-hlc
  (description "Implement Hybrid Logical Clock (HLC) with advance-on-send and advance-on-receive semantics; node_id is injected; wall-clock read is injected via clock_source abstraction")
  (acceptance "HLC is strictly monotonically increasing under adversarial clock skew; tiebreak by node_id lexicographic order; no direct std::time import in hlc.rs"))

(meta task-validate
  (description "Implement delta validation: signature verification via ssi, seq-check for activeKey deltas, deactivation guard, unknown-DID rejection")
  (acceptance "TEST-004 passes; stale rotation rejected (TEST-007); deactivated DID rejects all non-deactivation deltas (TEST-009); returns typed error variants from CON-001"))

(meta task-resolve
  (description "Implement CRDT state → W3C DID Core JSON-LD materialisation in resolve.rs: @context, id, verificationMethod, authentication, service, didDocumentMetadata")
  (acceptance "Output validates against DID Core JSON-LD schema; versionId is BLAKE3 of serialised state; deactivated flag present in metadata"))

(meta task-did-type
  (description "Implement Did identifier type: did:crdt:<blake3-hash> format, parsing, display, and Serde impl")
  (acceptance "Did parses did:crdt:<64-hex-char> without allocation; Display round-trips; invalid formats return parse error"))

(meta task-proptest-merge
  (description "Write proptest property-based tests for merge commutativity (TEST-002), associativity (TEST-003), and idempotence (TEST-005)")
  (acceptance "All three properties pass with 10,000 proptest cases each; generator covers secp256k1 and Ed25519 keypairs"))

(meta task-proptest-rotation
  (description "Write key rotation convergence test (TEST-006) and stale rotation rejection test (TEST-007)")
  (acceptance "Concurrent rotation tiebreak is commutative and deterministic; seq ≤ current activeKey.seq is rejected"))

(meta task-proptest-deactivation
  (description "Write deactivation irreversibility test (TEST-009) and revocation monotonicity test (TEST-008)")
  (acceptance "Deactivated DID rejects re-activation delta and all field updates; revoked credential IDs never leave the G-Set"))

(meta task-benchmark-core
  (description "Write criterion benchmarks for merge throughput (TEST-019) and resolution latency (TEST-018)")
  (acceptance "Merge throughput ≥ 10,000 deltas/sec on single core; resolution p99 ≤ 1ms for 100 verificationMethods + 1000 data fields"))

(meta task-forbid-unsafe-core
  (description "Add #[forbid(unsafe_code)] to the core module; add CI check: cargo build --no-default-features; verify no imports from std::fs, std::net, std::io, tokio, iroh in core/")
  (acceptance "cargo clippy --no-default-features has zero unsafe violations (TEST-021); CI check passes (TEST-013)"))

;; ─── PHASE 2: SYNC LAYER ─────────────────────────────────────────────────

(given task-sync-protocol-messages)
(given task-iroh-blobs-store)
(given task-iroh-gossip-sync)
(given task-integration-two-node)
(given task-integration-offline-reunion)

(meta task-sync-protocol-messages
  (description "Define sync protocol message types (ANNOUNCE, REQUEST, DELTAS, STATE) as specified in CON-004; implement serde serialisation")
  (acceptance "All four message types serialise/deserialise; protocol.rs has no I/O; message format matches CON-004"))

(meta task-iroh-blobs-store
  (description "Implement store.rs: persist and retrieve Document CRDT state via iroh-blobs; pin content-addressed snapshots by BLAKE3 hash")
  (acceptance "Store round-trips Document bytes; content_hash() matches pinned blob address; gated behind 'sync' feature"))

(meta task-iroh-gossip-sync
  (description "Implement gossip.rs: iroh-gossip delta propagation; send ANNOUNCE on local delta creation; handle REQUEST and respond with DELTAS or STATE; deduplication by (did, hash) pairs")
  (acceptance "Gossip module compiles with 'sync' feature only; deduplication prevents re-broadcast of known states; peer connections managed via iroh-net"))

(meta task-integration-two-node
  (description "Integration test: start two peered did-crdt instances, create DID on node A, verify node B converges, update on node B, verify node A reflects update (TEST-015)")
  (acceptance "Convergence latency < 30s at p99; both nodes resolve identical DID document after each sync"))

(meta task-integration-offline-reunion
  (description "Integration test: partition two nodes, apply 50 deltas on A and 30 on B (different fields), reconnect, assert identical state with all 80 delta effects (TEST-016)")
  (acceptance "Zero data loss; content_hash() identical on both nodes after reunion; test completes within 60s"))

;; ─── PHASE 3: SERVICE LAYER ──────────────────────────────────────────────

(given task-axum-http-server)
(given task-http-handlers)
(given task-prometheus-metrics)
(given task-dockerise)
(given task-integration-http-api)

(meta task-axum-http-server
  (description "Implement server.rs: axum HTTP server with DID resolution endpoint (GET /{did}), delta submission (POST /dids/{did}/deltas), DID creation (POST /dids), metrics (GET /metrics); configuration for listen address, peers, storage path")
  (acceptance "Server starts on configured port; graceful shutdown; request tracing via tower; gated behind 'service' feature"))

(meta task-http-handlers
  (description "Implement handlers.rs: route handlers for GET /{did} (200/404/410), POST /dids (201), POST /dids/{did}/deltas (202/400/403/409) per CON-003")
  (acceptance "All response codes per CON-003; application/did+ld+json content type on resolution; error bodies are structured JSON"))

(meta task-prometheus-metrics
  (description "Implement metrics.rs: emit OBS-001 through OBS-006 — convergence latency histogram, resolution latency histogram, merge throughput counter, delta rejection counter by reason, peer count gauge, state size gauge")
  (acceptance "All six OBS metrics emitting at /metrics in Prometheus exposition format; label sets match spec"))

(meta task-dockerise
  (description "Write Dockerfile for did-crdt service binary compiled with 'service' and 'sync' features; multi-stage build for minimal image size")
  (acceptance "docker build succeeds; image < 100MB; service starts and responds to GET / with 404 (no DID); health check endpoint present"))

(meta task-integration-http-api
  (description "Integration test for HTTP API: start service on localhost:0, POST /dids, GET /{did}, POST /dids/{did}/deltas, verify document updated, GET /nonexistent → 404 (TEST-014)")
  (acceptance "All HTTP status codes per CON-003; resolved document validates against DID Core JSON-LD schema; delta submission reflects in subsequent resolution"))

;; ─── PHASE 4: HARDENING ──────────────────────────────────────────────────

(given task-fuzz-delta-parse)
(given task-security-review-validate)
(given task-wasm-compat-check)
(given task-did-method-spec)
(given task-open-questions-adrs)

(meta task-fuzz-delta-parse
  (description "Write cargo-fuzz target for delta deserialisation (fuzz/fuzz_targets/delta_parse.rs); run fuzzing corpus; add found crashing inputs as regression tests")
  (acceptance "Fuzzing runs without crashes for 1 hour; all found crashes fixed and regressed; malformed delta inputs rejected cleanly"))

(meta task-security-review-validate
  (description "Cross-model adversarial review + human domain expert review of validate.rs and key rotation logic; review signature verification, seq-check, and authorisation rules per AI Trust Boundary (Tier 1)")
  (acceptance "Security review report produced; all findings addressed or risk-accepted with documented rationale; reviewer sign-off recorded"))

(meta task-wasm-compat-check
  (description "Validate pure core compiles to wasm32-unknown-unknown; verify crdts, ssi, and blake3 crate WASM compatibility; fix any incompatibilities")
  (acceptance "cargo build --target wasm32-unknown-unknown --no-default-features succeeds; no std::io or std::net imports in core module"))

(meta task-did-method-spec
  (description "Write W3C DID Method specification document for did:crdt: method syntax, CRUD operations, security considerations, privacy considerations; submit to DID Method Registry")
  (acceptance "Spec document covers all W3C DID Method spec requirements; CRUD operations match implementation; security section references threat model from section 16"))

(meta task-open-questions-adrs
  (description "Address open questions from section 18: write ADRs for compaction/GC strategy, key compromise recovery, sybil resistance, state size limits; update spec with decisions")
  (acceptance "ADR written for each of the four priority open questions; decisions are internally consistent; spec updated to reference new ADRs"))

;; ─── DEPENDENCY FACTS ────────────────────────────────────────────────────

;; Phase 1 internal dependencies encoded via readiness rules below.
;; scaffold-crate has no deps (seed task).
;; All other phase-1 tasks depend on scaffold-crate.

;; Phase 2 depends on phase-1 completion gate: task-forbid-unsafe-core
;; (represents all phase-1 quality gates passing).

;; Phase 3 depends on phase-2 completion gate: task-integration-offline-reunion.

;; Phase 4 depends on phase-3 completion gate: task-integration-http-api,
;; plus task-fuzz and task-security-review are parallel.

;; ─── READINESS RULES ─────────────────────────────────────────────────────

;; Phase 1
(normally r-ready-scaffold-crate
  (and task-scaffold-crate no-deps-scaffold-crate)
  ready-scaffold-crate)

(normally r-ready-crdt-field-wrappers
  (and task-crdt-field-wrappers completed-scaffold-crate)
  ready-crdt-field-wrappers)

(normally r-ready-did-type
  (and task-did-type completed-scaffold-crate)
  ready-did-type)

(normally r-ready-hlc
  (and task-hlc completed-scaffold-crate)
  ready-hlc)

(normally r-ready-signed-delta
  (and task-signed-delta completed-crdt-field-wrappers completed-did-type)
  ready-signed-delta)

(normally r-ready-validate
  (and task-validate completed-signed-delta completed-did-type)
  ready-validate)

(normally r-ready-document-struct
  (and task-document-struct completed-crdt-field-wrappers completed-did-type)
  ready-document-struct)

(normally r-ready-resolve
  (and task-resolve completed-document-struct)
  ready-resolve)

(normally r-ready-proptest-merge
  (and task-proptest-merge completed-document-struct completed-signed-delta completed-validate)
  ready-proptest-merge)

(normally r-ready-proptest-rotation
  (and task-proptest-rotation completed-validate completed-crdt-field-wrappers)
  ready-proptest-rotation)

(normally r-ready-proptest-deactivation
  (and task-proptest-deactivation completed-validate completed-crdt-field-wrappers)
  ready-proptest-deactivation)

(normally r-ready-benchmark-core
  (and task-benchmark-core completed-document-struct completed-resolve)
  ready-benchmark-core)

(normally r-ready-forbid-unsafe-core
  (and task-forbid-unsafe-core
       completed-proptest-merge
       completed-proptest-rotation
       completed-proptest-deactivation
       completed-benchmark-core)
  ready-forbid-unsafe-core)

;; Phase 2
(normally r-ready-sync-protocol-messages
  (and task-sync-protocol-messages completed-forbid-unsafe-core)
  ready-sync-protocol-messages)

(normally r-ready-iroh-blobs-store
  (and task-iroh-blobs-store completed-sync-protocol-messages)
  ready-iroh-blobs-store)

(normally r-ready-iroh-gossip-sync
  (and task-iroh-gossip-sync completed-sync-protocol-messages completed-iroh-blobs-store)
  ready-iroh-gossip-sync)

(normally r-ready-integration-two-node
  (and task-integration-two-node completed-iroh-gossip-sync)
  ready-integration-two-node)

(normally r-ready-integration-offline-reunion
  (and task-integration-offline-reunion completed-integration-two-node)
  ready-integration-offline-reunion)

;; Phase 3
(normally r-ready-axum-http-server
  (and task-axum-http-server completed-integration-offline-reunion)
  ready-axum-http-server)

(normally r-ready-http-handlers
  (and task-http-handlers completed-axum-http-server)
  ready-http-handlers)

(normally r-ready-prometheus-metrics
  (and task-prometheus-metrics completed-axum-http-server)
  ready-prometheus-metrics)

(normally r-ready-dockerise
  (and task-dockerise completed-http-handlers completed-prometheus-metrics)
  ready-dockerise)

(normally r-ready-integration-http-api
  (and task-integration-http-api completed-http-handlers)
  ready-integration-http-api)

;; Phase 4
(normally r-ready-fuzz-delta-parse
  (and task-fuzz-delta-parse completed-integration-http-api)
  ready-fuzz-delta-parse)

(normally r-ready-security-review-validate
  (and task-security-review-validate completed-validate completed-integration-http-api)
  ready-security-review-validate)

(normally r-ready-wasm-compat-check
  (and task-wasm-compat-check completed-forbid-unsafe-core)
  ready-wasm-compat-check)

(normally r-ready-did-method-spec
  (and task-did-method-spec completed-integration-http-api completed-security-review-validate)
  ready-did-method-spec)

(normally r-ready-open-questions-adrs
  (and task-open-questions-adrs completed-integration-http-api)
  ready-open-questions-adrs)

