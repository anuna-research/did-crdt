  (and ready-fuzz-delta-parse agent-engineer-available)
  assign-to-fuzz-delta-parse-engineer)

(normally r-assign-security-review-validate-engineer
  (and ready-security-review-validate agent-engineer-available)
  assign-to-security-review-validate-engineer)

(normally r-assign-security-review-validate-security
  (and ready-security-review-validate agent-security-available)
  assign-to-security-review-validate-security)

(normally r-assign-wasm-compat-check
  (and ready-wasm-compat-check agent-engineer-available)
  assign-to-wasm-compat-check-engineer)

(normally r-assign-did-method-spec
  (and ready-did-method-spec agent-engineer-available)
  assign-to-did-method-spec-engineer)

(normally r-assign-open-questions-adrs
  (and ready-open-questions-adrs agent-engineer-available)
  assign-to-open-questions-adrs-engineer)

;; ─── SUPERIORITY ─────────────────────────────────────────────────────────

;; Security review of validate.rs requires BOTH security agent and engineer;
;; security agent assignment takes precedence to ensure it is not skipped.
(prefer r-assign-security-review-validate-security r-assign-security-review-validate-engineer)

;; ─── DEFEATERS / SAFETY CONSTRAINTS ──────────────────────────────────────

;; Security review is a Tier 1 hard gate: validate.rs cannot ship without it.
(except d-block-did-method-spec
  (not completed-security-review-validate)
  (not ready-did-method-spec))

;; Phase-1 quality gates must pass before sync layer begins.
(except d-block-sync-if-core-unsafe
  (not completed-forbid-unsafe-core)
  (not ready-sync-protocol-messages))

;; Deactivated DID blocks all further delta processing (mirrors REQ-007).
(except d-block-deactivated-did
  deactivated-did-flag
  (not ready-document-struct))

;; ─── RULE METADATA ───────────────────────────────────────────────────────

(meta d-block-did-method-spec
  (description "DID method specification cannot be published before security review of validate.rs passes")
  (justification "AI Trust Boundary Tier 1: cryptographic validation requires cross-model adversarial review and human domain expert sign-off (spec section 16)"))

(meta d-block-sync-if-core-unsafe
  (description "Sync layer must not begin until the pure core passes all quality gates including forbid(unsafe_code) and property tests")
  (justification "Phase 1 quality gate: all property tests pass, merge throughput ≥ 10,000/sec, no unsafe (spec section 19 Phase 1)"))

(meta r-assign-security-review-validate-security
  (description "Security agent is required co-reviewer for the validate.rs and key rotation Tier 1 security review")
  (justification "Spec section 16: cryptographic operations are a Tier 1 no-go area requiring cross-model adversarial review and human domain expert review"))
(claims supervisor:ed25519:zhT3QZyz
  :at "2026-03-10T07:14:40Z"
  (given delegated-v1-scaffold-crate-to-agent:claude)
  (given (during (leased-v1-scaffold-crate) (moment "2026-03-10T07:14:40Z") (moment "2026-03-10T07:44:40Z")))
  (given claim-v1-scaffold-crate-by-claude)
  (normally r-cl-state-v1-scaffold-crate-by-claude claim-v1-scaffold-crate-by-claude state-claimed-v1-scaffold-crate-by-claude)
  (normally r-cl-chain-v1-scaffold-crate-by-claude state-claimed-v1-scaffold-crate-by-claude claimed-scaffold-crate)
)

;; Propagation rules: failures in 'scaffold-crate' block downstream tasks
(normally r-propagate-crdt-field-wrappers-from-scaffold-crate-failed failed-scaffold-crate upstream-blocked-crdt-field-wrappers)
(normally r-propagate-crdt-field-wrappers-from-scaffold-crate-permanently-failed permanently-failed-scaffold-crate upstream-blocked-crdt-field-wrappers)
(normally r-propagate-crdt-field-wrappers-from-scaffold-crate-stale-v1 stale-v1-scaffold-crate upstream-blocked-crdt-field-wrappers)
(normally r-propagate-crdt-field-wrappers-from-scaffold-crate-timeout-v1 timeout-v1-scaffold-crate upstream-blocked-crdt-field-wrappers)
(normally r-propagate-crdt-field-wrappers-from-scaffold-crate-blocked upstream-blocked-scaffold-crate upstream-blocked-crdt-field-wrappers)
(normally r-propagate-did-type-from-scaffold-crate-failed failed-scaffold-crate upstream-blocked-did-type)
(normally r-propagate-did-type-from-scaffold-crate-permanently-failed permanently-failed-scaffold-crate upstream-blocked-did-type)
(normally r-propagate-did-type-from-scaffold-crate-stale-v1 stale-v1-scaffold-crate upstream-blocked-did-type)
(normally r-propagate-did-type-from-scaffold-crate-timeout-v1 timeout-v1-scaffold-crate upstream-blocked-did-type)
(normally r-propagate-did-type-from-scaffold-crate-blocked upstream-blocked-scaffold-crate upstream-blocked-did-type)
(normally r-propagate-hlc-from-scaffold-crate-failed failed-scaffold-crate upstream-blocked-hlc)
(normally r-propagate-hlc-from-scaffold-crate-permanently-failed permanently-failed-scaffold-crate upstream-blocked-hlc)
(normally r-propagate-hlc-from-scaffold-crate-stale-v1 stale-v1-scaffold-crate upstream-blocked-hlc)
(normally r-propagate-hlc-from-scaffold-crate-timeout-v1 timeout-v1-scaffold-crate upstream-blocked-hlc)
(normally r-propagate-hlc-from-scaffold-crate-blocked upstream-blocked-scaffold-crate upstream-blocked-hlc)

;; Transitive propagation: upstream-blocked cascades through dependency chain
(normally r-propagate-document-struct-from-crdt-field-wrappers-blocked upstream-blocked-crdt-field-wrappers upstream-blocked-document-struct)
(normally r-propagate-proptest-deactivation-from-crdt-field-wrappers-blocked upstream-blocked-crdt-field-wrappers upstream-blocked-proptest-deactivation)
(normally r-propagate-proptest-rotation-from-crdt-field-wrappers-blocked upstream-blocked-crdt-field-wrappers upstream-blocked-proptest-rotation)
(normally r-propagate-signed-delta-from-crdt-field-wrappers-blocked upstream-blocked-crdt-field-wrappers upstream-blocked-signed-delta)
(normally r-propagate-document-struct-from-did-type-blocked upstream-blocked-did-type upstream-blocked-document-struct)
(normally r-propagate-signed-delta-from-did-type-blocked upstream-blocked-did-type upstream-blocked-signed-delta)
(normally r-propagate-validate-from-did-type-blocked upstream-blocked-did-type upstream-blocked-validate)
(normally r-propagate-benchmark-core-from-document-struct-blocked upstream-blocked-document-struct upstream-blocked-benchmark-core)
