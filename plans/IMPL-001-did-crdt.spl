(normally r-assign-iroh-blobs-store
  (and ready-iroh-blobs-store agent-engineer-available)
  assign-to-iroh-blobs-store-engineer)

(normally r-assign-iroh-gossip-sync
  (and ready-iroh-gossip-sync agent-engineer-available)
  assign-to-iroh-gossip-sync-engineer)

