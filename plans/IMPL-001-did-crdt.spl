  (and ready-axum-http-server agent-engineer-available)
  assign-to-axum-http-server-engineer)

(normally r-assign-http-handlers
  (and ready-http-handlers agent-engineer-available)
  assign-to-http-handlers-engineer)

(normally r-assign-prometheus-metrics
  (and ready-prometheus-metrics agent-engineer-available)
  assign-to-prometheus-metrics-engineer)

